# =====================================================================
#  Algo India — config (.env)
#  Copy karo:  cp .env.example .env   phir apne values bharo.
#  Ye file secrets ke liye hai — .env git me commit NAHI hoti.
# =====================================================================

# ---------- mode ----------
# demo  = synthetic data + paper broker (broker/time ki zarurat nahi, kabhi bhi chalao)
# paper = real broker data, par orders sirf simulate hote hain (paisa nahi lagta)
# live  = REAL orders REAL paisa. Pehle paper me hafta bhar chalao.
MODE=demo

# demo mode me virtual clock kitna tez chale (60 = 60x, poora session ~6 min)
DEMO_SPEED=60

# ---------- market ----------
SYMBOL=NIFTY                 # NIFTY | BANKNIFTY | SENSEX
EXCHANGE=NFO                # NFO (NSE F&O) | BFO (BSE F&O)
INSTRUMENT=ATM              # ATM | ITM1 | ITM2 | OTM1 | OTM2  (option strike choice)

# ---------- strategy ----------
STRATEGY=orb                # orb | ema_cross | supertrend_adx | vwap_reversion
STRATEGY_MODE=auto          # auto = python service chale to usse, warna TS local
STRATEGY_URL=http://127.0.0.1:8787

# ---------- broker ----------
BROKER=paper                # paper | zerodha | angel | fyers | upstox | dhan
PRODUCT=MIS                 # MIS (intraday) — index options me MIS/NRML
SLIPPAGE_PCT=0.35           # paper fill slippage (percent of premium / points)

# ---------- AI (jev-style layer) ----------
# off    = sirf rule-based strategy (AI kuch nahi karta)
# veto   = strategy signal bane, AI haan/na bole (confidence threshold)
# decide = AI final decision leta hai (strategy sirf context deta hai)
AI_MODE=off
AI_PROVIDER=openai          # openai | anthropic | google | openai-compatible
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=                # openai-compatible ke liye (OpenRouter/Groq/Ollama etc.)
AI_MIN_CONFIDENCE=0.6

# ---------- risk ----------
CAPITAL=200000              # trading capital (₹)
RISK_PCT=1.0                # percent of capital risk per trade
MAX_LOTS=2                  # ek position me max lots
MAX_TRADES_PER_DAY=3
DAILY_LOSS_PCT=2.0          # isse zyada loss hua to din khatam
MAX_CONSEC_LOSSES=3         # lagatar itne loss pe engine band
COOLDOWN_MINUTES=15         # loss ke baad itni der koi entry nahi
MIN_PREMIUM=40              # isse sasta option nahi (charges kha jaate hain)
PREMIUM_SL_CAP_PCT=30       # index SL → premium SL: max itna % premium risk me
PREMIUM_SL_FLOOR_PCT=12     # noise se SL hit na ho — kam se kam itna % move
PREMIUM_SAFETY_PCT=60       # disaster stop: premium itna % gire to exit (IV crush/gap)
MIN_ONE_LOT=true            # chhote account me 1 lot allow (agar risk cap ke andar)
MAX_SINGLE_LOT_RISK_PCT=3.0 # min-one-lot ke liye hard cap (% of capital)
NO_TRADE_BEFORE=09:20
ENTRY_CUTOFF=14:45
SQUARE_OFF=15:15

# ---------- engine/server ----------
HOST=0.0.0.0
PORT=8788
DATA_DIR=data
KILL_SWITCH_FILE=KILL       # ye file mile to engine turant square-off karke rukta hai
LOG_LEVEL=info

# ---------- python strategy service ----------
PY_PORT=8787

# =====================================================================
#  Broker credentials — sirf jis broker ko use kar rahe ho wahi bharo
# =====================================================================

# Zerodha Kite Connect (https://kite.trade)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=       # roz subah login se naya token (broker login script)

# Angel One SmartAPI (https://smartapi.angelone.in)
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
ANGEL_JWT_TOKEN=            # ya direct JWT/refresh token agar generate kiya hua hai

# Fyers API v3 (https://myapi.fyers.in)
FYERS_CLIENT_ID=            # jaise ABC12345-100
FYERS_SECRET=
FYERS_ACCESS_TOKEN=         # daily refresh (auth code flow)

# Upstox API v2 (https://upstox.com/developer)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# Dhan HQ v2 (https://dhanhq.co)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

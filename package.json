{
  "name": "algo-india",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Indian market algo trading system — Python strategies/backtest + TypeScript live engine & dashboard (index options F&O)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "MODE=demo tsx src/index.ts",
    "paper": "MODE=paper tsx src/index.ts",
    "live": "MODE=live tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/tests/run.ts",
    "py:serve": "python3 py/run.py serve",
    "py:list": "python3 py/run.py list",
    "py:demo": "python3 py/run.py demo",
    "py:test": "python3 -m unittest discover -s py/tests -t py -q"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
